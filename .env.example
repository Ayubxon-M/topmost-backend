# Bu namuna fayl. Nusxa oling:  copy .env.example .env   (Linux: cp .env.example .env)
# va qiymatlarni o'zingiznikiga almashtiring. .env GitHub'ga chiqmaydi.

# Development (kompyuteringizda): True.  Serverda: False
DEBUG=True

# Uzun tasodifiy kalit. Yangisini yaratish:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Serverda: sizning domeningiz (bir nechta bo'lsa vergul bilan). Bo'sh qolsa va DEBUG=True bo'lsa — hamma manzil.
ALLOWED_HOSTS=

# Serverda admin panel uchun: https:// bilan to'liq manzil
CSRF_TRUSTED_ORIGINS=

# /privacy/ sahifasida ko'rinadigan aloqa (akkauntni o'chirish so'rovlari uchun). Masalan:
# PRIVACY_CONTACT=Telegram @topmost_admin yoki +998 90 123 45 67
PRIVACY_CONTACT=

# python serve.py qaysi portda ishlasin
PORT=8000

# E'lon rasmlarini Django bersinmi: nginx bo'lmasa True, nginx bo'lsa False
SERVE_MEDIA=True

# nginx/proksi orqasida tursa, uning IP manzili (masalan 127.0.0.1). Bo'lmasa bo'sh qoldiring.
TRUSTED_PROXY=

# Faqat DEBUG=False bo'lganda ishlaydi. SSL sertifikat ulangan bo'lsa True.
# Vaqtincha http:// orqali sinash kerak bo'lsa False qiling.
HTTPS=True
